{
  "name": "term-llm-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hugo --cleanDestinationDir --destination ../.cache/docs-site && pagefind --site ../.cache/docs-site",
    "test": "npm run build && node scripts/check-site.mjs",
    "capture:product": "node scripts/capture-product.mjs",
    "capture:tour": "node scripts/capture-tour.mjs && node scripts/optimize-tour.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "pagefind": "1.6.0",
    "playwright": "1.65.0",
    "sharp": "0.35.5"
  }
}
