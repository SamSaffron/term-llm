#!/usr/bin/env bash
# Update pinned Web UI runtime dependencies and regenerate committed assets.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root/frontend"

npm install --save-exact \
  preact@latest \
  @preact/signals@latest \
  marked@latest \
  dompurify@latest \
  katex@latest \
  highlight.js@latest
npm run typecheck
npm test
npm run build

echo "Updated frontend/package.json, package-lock.json, and internal/serveui/static/dist."
echo "Review dependency release notes, generated assets, payload measurements, and git diff before committing."
