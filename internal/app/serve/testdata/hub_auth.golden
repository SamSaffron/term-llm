  node-good gate=false status=401 body="invalid hub authentication credentials"
  node-unknown gate=false status=401 body="invalid hub authentication credentials"
  registration gate=false status=401 body="invalid hub authentication credentials"
  OPTIONS gate=true status=405 body="method not allowed" Allow="DELETE"
