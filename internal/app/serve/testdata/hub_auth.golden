bearer browser navigation gate=false status=401 body="shell:bearer-login"
bearer browser query-token gate=false status=302 body="<a href=\"/hub/?keep=1\">Found</a>." Location="/hub/?keep=1" cookie=term_llm_hub_token:set:path=/hub/:httpOnly=true:secure=false:sameSite=3
bearer browser bearer-cookie gate=true status=200 body="shell:dashboard"
