# gate=true means only that the outer middleware reached a sentinel, NOT handler authentication.
# body records error text, JSON top-level keys, shell page, or asset content type; random session/ceremony data is omitted.
bearer GET / [hub /]
  anon gate=false status=401 body="invalid hub authentication credentials"
  hub-bearer gate=true status=200 body="shell:dashboard"
  node-missing gate=false status=401 body="invalid hub authentication credentials"
  node-bad gate=false status=401 body="invalid hub authentication credentials"
  node-good gate=false status=401 body="invalid hub authentication credentials"
  node-unknown gate=false status=401 body="invalid hub authentication credentials"
  registration gate=false status=401 body="invalid hub authentication credentials"
  OPTIONS gate=true status=405 body="" Allow="GET, HEAD"
bearer GET /api/attention [hub /api/attention]
  anon gate=false status=401 body="invalid hub authentication credentials"
  hub-bearer gate=true status=200 body="json:has_more,inbox,input_required,nodes,total_input_required,total_running,total_unseen"
  node-missing gate=false status=401 body="invalid hub authentication credentials"
  node-bad gate=false status=401 body="invalid hub authentication credentials"
  node-good gate=false status=401 body="invalid hub authentication credentials"
  node-unknown gate=false status=401 body="invalid hub authentication credentials"
  registration gate=false status=401 body="invalid hub authentication credentials"
  OPTIONS gate=true status=405 body="method not allowed" Allow="GET"
bearer POST /api/attention/clear [hub /api/attention/clear]
  anon gate=false status=401 body="invalid hub authentication credentials"
  hub-bearer gate=true status=200 body="json:cleared,failed"
  node-missing gate=false status=401 body="invalid hub authentication credentials"
  node-bad gate=false status=401 body="invalid hub authentication credentials"
  node-good gate=false status=401 body="invalid hub authentication credentials"
  node-unknown gate=false status=401 body="invalid hub authentication credentials"
  registration gate=false status=401 body="invalid hub authentication credentials"
  OPTIONS gate=true status=405 body="method not allowed" Allow="POST"
bearer POST /api/attention/seen [hub /api/attention/seen]
  anon gate=false status=401 body="invalid hub authentication credentials"
  hub-bearer gate=true status=400 body="store_instance_id, session_id and a positive attention_seq are required"
  node-missing gate=false status=401 body="invalid hub authentication credentials"
  node-bad gate=false status=401 body="invalid hub authentication credentials"
  node-good gate=false status=401 body="invalid hub authentication credentials"
  node-unknown gate=false status=401 body="invalid hub authentication credentials"
  registration gate=false status=401 body="invalid hub authentication credentials"
  OPTIONS gate=true status=405 body="method not allowed" Allow="POST"
bearer GET /api/connect [hub /api/connect]
  anon gate=true status=401 body="missing X-Term-LLM-Node-ID header"
  hub-bearer gate=true status=401 body="missing X-Term-LLM-Node-ID header"
  node-missing gate=true status=401 body="missing bearer token"
  node-bad gate=true status=401 body="node authentication failed"
  node-good gate=true status=400 body="Bad Request"
  node-unknown gate=true status=401 body="node authentication failed"
  registration gate=true status=401 body="missing X-Term-LLM-Node-ID header"
  OPTIONS gate=true status=405 body="method not allowed" Allow="GET"
bearer GET /api/delegations [hub /api/delegations]
  anon gate=false status=401 body="invalid hub authentication credentials"
  hub-bearer gate=true status=200 body="json:delegations"
  node-missing gate=true status=401 body="unauthorized"
  node-bad gate=true status=401 body="unauthorized"
  node-good gate=true status=200 body="json:delegations"
  node-unknown gate=true status=401 body="unauthorized"
  registration gate=false status=401 body="invalid hub authentication credentials"
  OPTIONS gate=true status=405 body="method not allowed" Allow="GET, POST"
bearer GET /api/delegations/missing [hub /api/delegations/]
  anon gate=false status=401 body="invalid hub authentication credentials"
  hub-bearer gate=true status=404 body="unknown delegation \"missing\""
  node-missing gate=true status=401 body="unauthorized"
  node-bad gate=true status=401 body="unauthorized"
  node-good gate=true status=404 body="unknown delegation \"missing\""
  node-unknown gate=true status=401 body="unauthorized"
  registration gate=false status=401 body="invalid hub authentication credentials"
  OPTIONS gate=true status=405 body="method not allowed" Allow="GET"
