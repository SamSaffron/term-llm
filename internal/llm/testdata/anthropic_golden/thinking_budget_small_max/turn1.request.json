{
  "method": "POST",
  "path": "/v1/messages",
  "headers": {
    "accept": [
      "application/json"
    ],
    "anthropic-version": [
      "2023-06-01"
    ],
    "content-type": [
      "application/json"
    ],
    "x-api-key": [
      "<present>"
    ]
  },
  "body": {
    "max_tokens": 2048,
    "messages": [
      {
        "content": [
          {
            "cache_control": {
              "type": "ephemeral"
            },
            "text": "Say hi.",
            "type": "text"
          }
        ],
        "role": "user"
      }
    ],
    "model": "claude-opus-4-5",
    "stream": true,
    "thinking": {
      "budget_tokens": 2047,
      "type": "enabled"
    }
  }
}
