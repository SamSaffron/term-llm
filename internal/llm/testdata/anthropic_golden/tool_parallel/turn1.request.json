{
  "method": "POST",
  "path": "/v1/messages",
  "headers": {
    "accept": [
      "application/json"
    ],
    "anthropic-version": [
      "2023-06-01"
    ],
    "content-type": [
      "application/json"
    ],
    "x-api-key": [
      "<present>"
    ]
  },
  "body": {
    "max_tokens": 4096,
    "messages": [
      {
        "content": [
          {
            "cache_control": {
              "type": "ephemeral"
            },
            "text": "Read a.txt and b.txt using two read_file calls in the same turn, then report both values.",
            "type": "text"
          }
        ],
        "role": "user"
      }
    ],
    "model": "claude-haiku-4-5",
    "stream": true,
    "system": [
      {
        "cache_control": {
          "type": "ephemeral"
        },
        "text": "You are a terse assistant used for wire-format golden tests.",
        "type": "text"
      }
    ],
    "tool_choice": {
      "disable_parallel_tool_use": false,
      "type": "auto"
    },
    "tools": [
      {
        "cache_control": {
          "type": "ephemeral"
        },
        "description": "Read a text file from the working directory.",
        "input_schema": {
          "properties": {
            "path": {
              "description": "Relative file path",
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        },
        "name": "read_file"
      }
    ]
  }
}
