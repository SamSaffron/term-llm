{
  "method": "POST",
  "path": "/model/us.anthropic.claude-sonnet-4-6/invoke-with-response-stream",
  "headers": {
    "accept": [
      "application/json"
    ],
    "anthropic-version": [
      "2023-06-01"
    ],
    "authorization": [
      "AWS4-HMAC-SHA256 Credential=AKIDGOLDENEXAMPLE/<date>/..."
    ],
    "content-type": [
      "application/json"
    ],
    "x-amz-date": [
      "<present>"
    ],
    "x-amz-security-token": [
      "golden-session"
    ]
  },
  "body": {
    "anthropic_version": "bedrock-2023-05-31",
    "max_tokens": 16000,
    "messages": [
      {
        "content": [
          {
            "cache_control": {
              "type": "ephemeral"
            },
            "text": "Use read_file on notes.txt and tell me the secret word.",
            "type": "text"
          }
        ],
        "role": "user"
      }
    ],
    "system": [
      {
        "cache_control": {
          "type": "ephemeral"
        },
        "text": "You are a terse assistant used for wire-format golden tests.",
        "type": "text"
      }
    ],
    "thinking": {
      "type": "adaptive"
    },
    "tools": [
      {
        "cache_control": {
          "type": "ephemeral"
        },
        "description": "Read a text file from the working directory.",
        "input_schema": {
          "properties": {
            "path": {
              "description": "Relative file path",
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        },
        "name": "read_file"
      }
    ]
  }
}
