{
  "method": "POST",
  "path": "/v1/messages",
  "query": "beta=true",
  "headers": {
    "accept": [
      "application/json"
    ],
    "anthropic-beta": [
      "web-search-2025-03-05",
      "web-fetch-2025-09-10"
    ],
    "anthropic-version": [
      "2023-06-01"
    ],
    "content-type": [
      "application/json"
    ],
    "x-api-key": [
      "<present>"
    ]
  },
  "body": {
    "max_tokens": 16000,
    "messages": [
      {
        "content": [
          {
            "cache_control": {
              "type": "ephemeral"
            },
            "text": "Reply with exactly: ok. Do not search.",
            "type": "text"
          }
        ],
        "role": "user"
      }
    ],
    "model": "claude-opus-4-5",
    "stream": true,
    "thinking": {
      "budget_tokens": 10000,
      "type": "enabled"
    },
    "tools": [
      {
        "max_uses": 5,
        "name": "web_search",
        "type": "web_search_20250305"
      },
      {
        "max_uses": 3,
        "name": "web_fetch",
        "type": "web_fetch_20250910"
      },
      {
        "cache_control": {
          "type": "ephemeral"
        },
        "description": "Read a text file from the working directory.",
        "input_schema": {
          "properties": {
            "path": {
              "description": "Relative file path",
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        },
        "name": "read_file"
      }
    ]
  }
}
