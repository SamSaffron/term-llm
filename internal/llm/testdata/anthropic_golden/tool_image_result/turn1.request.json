{
  "method": "POST",
  "path": "/v1/messages",
  "headers": {
    "accept": [
      "application/json"
    ],
    "anthropic-version": [
      "2023-06-01"
    ],
    "content-type": [
      "application/json"
    ],
    "x-api-key": [
      "<present>"
    ]
  },
  "body": {
    "max_tokens": 4096,
    "messages": [
      {
        "content": [
          {
            "cache_control": {
              "type": "ephemeral"
            },
            "text": "Use view_image on red.png and tell me its colour in one word.",
            "type": "text"
          }
        ],
        "role": "user"
      }
    ],
    "model": "claude-haiku-4-5",
    "stream": true,
    "system": [
      {
        "cache_control": {
          "type": "ephemeral"
        },
        "text": "You are a terse assistant used for wire-format golden tests.",
        "type": "text"
      }
    ],
    "tool_choice": {
      "disable_parallel_tool_use": true,
      "type": "auto"
    },
    "tools": [
      {
        "cache_control": {
          "type": "ephemeral"
        },
        "description": "View an image file.",
        "input_schema": {
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        },
        "name": "view_image"
      }
    ]
  }
}
