{
  "method": "POST",
  "path": "/v1/messages",
  "headers": {
    "accept": [
      "application/json"
    ],
    "anthropic-version": [
      "2023-06-01"
    ],
    "content-type": [
      "application/json"
    ],
    "x-api-key": [
      "<present>"
    ]
  },
  "body": {
    "max_tokens": 4096,
    "messages": [
      {
        "content": [
          {
            "source": {
              "data": "iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAAFklEQVR4nGO4I2JDEmIY1TCqYfhqAAAeBCwQ8YdREQAAAABJRU5ErkJggg==",
              "media_type": "image/png",
              "type": "base64"
            },
            "type": "image"
          },
          {
            "text": "[image saved at: /tmp/red.png]",
            "type": "text"
          },
          {
            "cache_control": {
              "type": "ephemeral"
            },
            "text": "What colour is this image? One word.",
            "type": "text"
          }
        ],
        "role": "user"
      }
    ],
    "model": "claude-haiku-4-5",
    "stream": true
  }
}
