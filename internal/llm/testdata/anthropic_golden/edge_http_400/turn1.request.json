{
  "method": "POST",
  "path": "/v1/messages",
  "headers": {
    "accept": [
      "application/json"
    ],
    "anthropic-version": [
      "2023-06-01"
    ],
    "content-type": [
      "application/json"
    ],
    "x-api-key": [
      "<present>"
    ]
  },
  "body": {
    "max_tokens": 4096,
    "messages": [
      {
        "content": [
          {
            "cache_control": {
              "type": "ephemeral"
            },
            "text": "edge",
            "type": "text"
          }
        ],
        "role": "user"
      }
    ],
    "model": "claude-sonnet-4-6",
    "stream": true
  }
}
