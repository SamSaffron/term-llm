# Secrets loaded by term-llm-web.service.
#
# Install this file as .env with mode 0600. This uses systemd EnvironmentFile
# syntax, not shell syntax: do not use `export`, command substitutions, or
# references such as $HOME.

# Required for a stable Web UI login across service restarts.
# Generate one with: openssl rand -hex 32
TERM_LLM_SERVE_TOKEN=replace-with-a-long-random-token

# Uncomment the credential used by your configured built-in provider.
# Providers that use OAuth, local CLI login, AWS credentials, or no credentials
# do not need an API key here.
# ANTHROPIC_API_KEY=replace-me
# OPENAI_API_KEY=replace-me
# GEMINI_API_KEY=replace-me
# OPENROUTER_API_KEY=replace-me
# ZEN_API_KEY=replace-me
# OPENCODE_API_KEY=replace-me
# XAI_API_KEY=replace-me
# VENICE_API_KEY=replace-me
# NEARAI_API_KEY=replace-me
# SAMBANOVA_API_KEY=replace-me
# VLLM_API_KEY=replace-me
# CURSOR_API_KEY=replace-me

# Optional: register this Web UI as a reverse-connected Hub node. The four
# TERM_LLM_SERVE_HUB_* settings are interpreted by run-term-llm-web.sh in this
# example, not directly by the term-llm binary. The installer can prompt for
# these values and safely quote them. TERM_LLM_SERVE_TOKEN above is also the
# stable node bearer token that the Hub stores during registration.
# TERM_LLM_SERVE_HUB_URL=https://hub.example.com
# TERM_LLM_SERVE_HUB_NODE_ID=my-node
# TERM_LLM_SERVE_HUB_NODE_NAME=My node
# TERM_LLM_SERVE_HUB_REGISTER=1
# TERM_LLM_HUB_REGISTRATION_TOKEN=replace-with-the-hub-registration-token

# Avoid interactive release notices in service logs. This does not disable the
# example's local binary-change check.
TERM_LLM_SKIP_UPDATE_CHECK=1
