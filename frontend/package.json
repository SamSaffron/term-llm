{
  "name": "term-llm-webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:chat && npm run build:hub && npm run build:compress",
    "build:chat": "vite build",
    "build:hub": "vite build --config vite.hub.config.ts",
    "build:compress": "go run ../cmd/precompressui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:ts": "oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "@taga3s/highlightjs-terraform": "1.0.7",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "marked": "18.2.0",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/preact": "3.2.6",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/trusted-types": "2.0.7",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "31.0.0",
    "oxlint": "1.93.0",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
